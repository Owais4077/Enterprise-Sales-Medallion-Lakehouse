# Copy to .env and fill in. NEVER commit .env.
# local | ci | aws
ENVIRONMENT=local

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_LAKE_ROOT=data/lake
S3_BUCKET=
S3_PREFIX=edp
# AWS credentials come from the standard AWS chain (aws configure / IAM role), not from this file.

# --- Ingestion working areas (relative paths are inside the project) ---
LANDING_DIR=data/landing
RAW_DATA_DIR=data/raw
STATE_DB_PATH=data/state/pipeline_state.db

# --- Source PostgreSQL (the operational "OLTP" database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_oltp
POSTGRES_USER=edp_user
POSTGRES_PASSWORD=change_me

# --- REST API source (mock service in Phase 2) ---
API_BASE_URL=http://localhost:8000
API_KEY=change_me

# --- Logging ---
LOG_LEVEL=INFO

# --- Mock API failure injection (0 = off; N = every Nth request returns 503) ---
MOCK_API_FAIL_EVERY_N=0

# Host port for the mock API (change if 8000 is already in use)
MOCK_API_PORT=8000
