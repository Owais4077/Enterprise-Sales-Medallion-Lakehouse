# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=local                 # local | ci | aws

# --- Storage ---
STORAGE_BACKEND=local             # local | s3
LOCAL_LAKE_ROOT=data/lake
S3_BUCKET=
S3_PREFIX=edp
# AWS credentials come from the standard AWS chain (aws configure / IAM role), not from this file.

# --- Source PostgreSQL (the operational "OLTP" database) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sales_oltp
POSTGRES_USER=edp_user
POSTGRES_PASSWORD=change_me

# --- REST API source (mock service in Phase 2) ---
API_BASE_URL=http://localhost:8000
API_KEY=change_me

# --- Logging ---
LOG_LEVEL=INFO
